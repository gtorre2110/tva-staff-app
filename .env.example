VITE_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
VITE_SUPABASE_ANON_KEY=TUA-CHIAVE-ANON-PUBBLICA

# Facoltativa: impostare a "beta" SOLO sul deployment Vercel del branch
# beta. Mostra la scritta rossa "VERSIONE BETA" sopra al logo, per
# distinguere a colpo d'occhio la versione di prova da quella in produzione.
VITE_APP_ENV=beta

# Facoltativa: solo per il pulsante "Esporta su Google Drive".
# Senza questa variabile il pulsante resta semplicemente nascosto.
VITE_GOOGLE_CLIENT_ID=TUO-CLIENT-ID.apps.googleusercontent.com
